#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# If the node stops of its own accord, stop the whole app, so that Home
# Assistant shows it as stopped rather than as running and doing nothing. 256 is
# s6 saying that it was stopped on purpose.
if [[ "$1" -ne 0 && "$1" -ne 256 ]]; then
  bashio::log.warning "The Quiddity node stopped with status $1; stopping the app"
  /run/s6/basedir/bin/halt
fi
