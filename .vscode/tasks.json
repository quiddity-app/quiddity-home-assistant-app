{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Home Assistant",
      "type": "shell",
      "command": "supervisor_run",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Install app",
      "type": "shell",
      "command": "ha apps install local_quiddity",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Start app",
      "type": "shell",
      "command": "ha apps stop local_quiddity; ha apps start local_quiddity; ha apps logs -f local_quiddity",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Rebuild and start app",
      "type": "shell",
      "command": "ha apps rebuild --force local_quiddity; ha apps start local_quiddity; ha apps logs -f local_quiddity",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
