{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>andrewaylett/renovate-config"
  ],
  "customManagers": [
    {
      "description": "The commit of Quiddity that the Dockerfile builds, which has no release to follow yet",
      "customType": "regex",
      "managerFilePatterns": [
        "/^quiddity/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=git-refs depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\nARG QUIDDITY_REF=(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "The pinned commit is built into an image whose tag is the app's version, so a bump to it must be reviewed together with that version",
      "matchDepNames": [
        "https://github.com/quiddity-app/quiddity"
      ],
      "automerge": false
    }
  ]
}
